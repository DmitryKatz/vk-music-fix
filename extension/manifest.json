{
  "manifest_version": 3,
  "name": "VK Music Fix",
  "version": "1.1.0",
  "description": "Музыка в веб-версии ВК без самопроизвольных скипов и подвисаний: трек целиком кешируется заранее. Встроенная отладка (Alt+Shift+D).",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://vk.ru/*", "https://*.vk.ru/*", "https://vk.com/*", "https://*.vk.com/*"],
      "js": ["fix.js", "panel.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
